CompileFlags:
  Compiler: toolchain/bin/arm-none-eabi-g++
  # BuiltinHeaders: QueryDriver NOT SUPPORTED
Diagnostics:
  Suppress: [non_asm_stmt_in_naked_function, -Wunknown-attributes]
  ClangTidy:
    Add: [
      clang-diagnostic-*,
      clang-analyzer-*,
      cppcoreguidelines-*,
      bugprone-*,
      modernize-*,
      readability-*,
      google-*,
      misc-*,
      performance-*
    ]
    Remove: [
      performance-enum-size,   # Size gain is very minimal
      google-readability-todo, # I don't want to have to write authors at every TODO >:(
      misc-misplaced-const     # Sometimes thinks `const int*` is the same as `int * const`
    ]
    FastCheckFilter: None
Hover:
  ShowAKA: true

---
CompileFlags:
  CompilationDatabase: build/debug/
---
CompileFlags:
  Add: [
    -I/workspaces/repository/toolchain/arm-none-eabi/include,
    -I/workspaces/repository/toolchain/arm-none-eabi/include/c++/14.2.1,
    -I/workspaces/repository/toolchain/arm-none-eabi/include/c++/14.2.1/arm-none-eabi/thumb/nofp,
    -Weverything,
    -Wno-c++98-compat,
    -Wno-c++98-compat-pedantic,
    -Wno-c++20-compat,
    -Wno-documentation,
    -Wno-missing-prototypes
  ]